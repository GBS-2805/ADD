<?xml version="1.0" encoding="utf-8"?>
<!-- Review-only copy of app/AndroidManifest.xml with the engine activity added.
     The shipping manifest in app/ is intentionally left unchanged. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-sdk
        android:minSdkVersion="33"
        android:targetSdkVersion="35" />

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application
        android:name=".review.CrashWatch"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:label="ADD"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="ADD">

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ShelfActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="ADD"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CompareActivity"
            android:exported="false"
            android:label="Compare"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".EditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:label="Editor"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PacksActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:label="Font packs" />

        <!-- Debug-only destination. MainActivity reaches this by class name only
             when the APK is debuggable, so the release build has no entry path. -->
        <!-- Its own process: a native Filament fault or a Compose crash here must not
             take the shelf and the editor down with it, and the review crash net can
             then show what died on the next launch. -->
        <activity
            android:name="app.add.engine.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="${engineExported}"
            android:label="Engine Lab"
            android:process=":engine"
            android:screenOrientation="portrait"
            android:theme="@style/ReviewEngineTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- The saved trace, with COPY. Review-only, like the net that writes it. -->
        <activity
            android:name=".review.CrashReportActivity"
            android:exported="false"
            android:label="ADD stopped"
            android:theme="@style/ReviewEngineTheme" />
    </application>
</manifest>
