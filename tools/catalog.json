  "portfolio": [
    {
      "id": "compress",
      "title": "Compress",
      "kind": "Android app",
      "year": 2026,
      "summary": "An offline image compressor with a before/after slider, batch queue and per-file savings. No account, no uploads, no internet permission.",
      "built": "The whole app: picker flow, preview pipeline, encoder retry loop, queue management, sharing, launcher icon and the settings screen.",
      "stack": "Java, Android platform APIs only",
      "href": "/tools/"
    },
    {
      "id": "icons",
      "title": "Icons app and browser",
      "kind": "Android app + web tool",
      "year": 2026,
      "summary": "All 4,373 glyphs from four free brands with a live preview, variant controls and the set folded into a scrolling sheet; the same page ships as an offline Android app.",
      "built": "The fetch pipeline, the generated brand pages, the preview and variant logic, the collapsible set, the WebView wrapper that serves the bundle from a private origin, and the catalogs both read.",
      "stack": "Vanilla JavaScript, Java WebView, Python fetch script",
      "href": "/icons/"
    },
    {
      "id": "site",
      "title": "This site",
      "kind": "Static site",
      "year": 2026,
      "summary": "The shelf: catalogs for the tools, icons, fonts and work, all built from the same measurements as the app and all readable as JSON.",
      "built": "The measured layout, one shared stylesheet, the JSON builder that re-measures every shipped file, and the render gallery.",
