# Build output (rebuild with ./build.sh)
build/
dist/

# Python caches from the tools/ renderers
__pycache__/
*.pyc
.vercel

# Capture scratch: screenshots in progress, probes, old shots. Regenerated by
# tools/render_pages.js; the published copies live in docs/renders/.
artifacts/

# Test reports. tools/check_twin.py writes the vitest JUnit here and CI uploads it as
# an artifact; it is a result, not a source file.
test-results/

# Calibration runs cached by CI; a local run may create it too. It is a trail, not
# source, and never replaces the checked-in texture-trend.json baseline.
tools/engine-spike/texture-history.jsonl

# The app's web bundle is staged out of docs/ by build.sh; never edit or commit it.
app/assets/www/

# Written by tools/render_logo_mark.js.
tools/logo-mark.png

# Generated by tools/deploy_vercel.py; the parity check reads it.
docs/_deploy.json

# The capture toolchain's own install (playwright and its browsers' wrapper). It is
# disposable and restored by tools/render_env.py, and never part of a commit.
node_modules/

# Maven output from the native render harness; rebuilt by tools/android-render/render.sh.
tools/android-render/target/

# Local agent skill bundles. These are installed per workspace by the agent tooling, not
# project source; the same GSAP skills appear under several tool-specific directories.
.agents/
.claude/
agent/
skills-lock.json
