<?xml version="1.0" encoding="utf-8"?>
<!-- The Wheatpaste masthead surface: the page itself, with the palette's rule
     laid along the top edge. Used by the screens whose header is their own
     layout rather than the shared band, so every top bar carries the same rule. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/page" />
        </shape>
    </item>
    <item
        android:height="3dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="?attr/band" />
        </shape>
    </item>
</layer-list>
