<?xml version="1.0" encoding="utf-8"?>
<!--
  The side tab, as on the site: four destinations off the shelf and the note.
  There is one edition, so the panel ends at the note instead of a palette row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="?attr/page"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="18dp"
    android:paddingRight="20dp"
    android:paddingBottom="22dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/libre_franklin"
            android:letterSpacing="0.1"
            android:text="MORE"
            android:textColor="?attr/label"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/drawerClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_ripple"
            android:clickable="true"
            android:contentDescription="Close side panel"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="&#10005;"
            android:textColor="?attr/on"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="?attr/rule" />

    <!-- The tools, in the order the site lists them. Compress is the screen behind
         this panel, so its row closes the panel rather than opening another. -->
    <TextView
        android:id="@+id/linkIcons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/libre_franklin"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Icons"
        android:textColor="?attr/on"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/linkFonts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/libre_franklin"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Fonts"
        android:textColor="?attr/on"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/linkCompress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/libre_franklin"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Compress"
        android:textColor="?attr/on"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/linkEditor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/libre_franklin"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Editor"
        android:textColor="?attr/on"
        android:textSize="17sp" />

    <!-- The browser twin, bundled only in the research build. Hidden when the
         assets are absent, so a shipping APK never offers a dead row. -->
    <TextView
        android:id="@+id/linkTwin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/libre_franklin"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Twin"
        android:textColor="?attr/on"
        android:textSize="17sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="?attr/rule" />

    <TextView
        android:id="@+id/linkDownload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/libre_franklin"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Download"
        android:textColor="?attr/on"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/linkPortfolio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/libre_franklin"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Portfolio"
        android:textColor="?attr/on"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/linkRenders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/libre_franklin"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Renders"
        android:textColor="?attr/on"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/linkReleases"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/libre_franklin"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Releases"
        android:textColor="?attr/on"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/spectral_regular"
        android:layout_marginTop="14dp"
        android:text="ADD · one app: icons, fonts and batch photo compression, all offline."
        android:textColor="?attr/onDim"
        android:textSize="12sp" />

</LinearLayout>
