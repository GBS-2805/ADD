<?xml version="1.0" encoding="utf-8"?>
<!--
  The side tab, as on the site: four destinations off the shelf, then the theme
  toggle and the three palette chips at the foot, under the note.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="?attr/page"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="18dp"
    android:paddingRight="20dp"
    android:paddingBottom="22dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.14"
            android:text="MORE"
            android:textColor="?attr/label"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/drawerClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_ripple"
            android:clickable="true"
            android:contentDescription="Close side panel"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="&#10005;"
            android:textColor="?attr/on"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="?attr/rule" />

    <TextView
        android:id="@+id/linkDownload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Download"
        android:textColor="?attr/on"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/linkPortfolio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Portfolio"
        android:textColor="?attr/on"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/linkRenders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Renders"
        android:textColor="?attr/on"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/linkReleases"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Releases"
        android:textColor="?attr/on"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Compress · batch photos offline. The shelf is at the index."
        android:textColor="?attr/onDim"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/themeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Theme"
            android:textColor="?attr/onDim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/themeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dark"
            android:textColor="?attr/on"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Palette"
            android:textColor="?attr/onDim"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/palRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>
