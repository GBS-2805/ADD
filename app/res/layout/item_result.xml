<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:background="@drawable/bg_card_clickable"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingTop="12dp"
    android:paddingRight="10dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_thumb"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="?attr/on"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sizes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="monospace"
            android:textColor="?attr/onDim"
            android:textSize="10.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_pill"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:textColor="?attr/accentInk"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/shareOne"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_circle_ripple"
        android:clickable="true"
        android:contentDescription="Share this photo"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_share"
        android:tint="?attr/on" />
</LinearLayout>
