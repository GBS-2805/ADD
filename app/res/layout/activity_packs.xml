<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/packsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="@drawable/bg_masthead"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="2dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/packsBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="&#8249;"
            android:textColor="?attr/on"
            android:textSize="28sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/instrument_serif"
            android:letterSpacing="-0.01"
            android:text="Font packs"
            android:textColor="?attr/on"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/packsRefresh"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/libre_franklin"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="REFRESH"
            android:textColor="?attr/on"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="18dp"
            android:paddingRight="20dp"
            android:paddingBottom="26dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:text="Packs come from the site and stay on this phone. Download one here; the editor keeps using it with no connection."
                android:textColor="?attr/onDim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/packsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.15"
                android:text=""
                android:textColor="?attr/onDim"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/packsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/packsImport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Have a .addpack file? Import it…"
                android:textColor="?attr/onDim"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.15"
                android:text="Installed packs are kept in the app and work offline. Nothing downloads until you tap Download."
                android:textColor="?attr/onDim"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
