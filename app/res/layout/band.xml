<?xml version="1.0" encoding="utf-8"?>
<!--
  The Wheatpaste masthead: the ADD wordmark and plus on the page ink, with the
  orange rule the site uses. It is deliberately not a coloured band: the brand
  keeps the page dark and lets the rule, the plus and the chips carry the accent.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:background="?attr/page"
    android:paddingLeft="16dp"
    android:paddingRight="8dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:background="?attr/band" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start|center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_serif"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:singleLine="true"
            android:text="ADD"
            android:textColor="?attr/on"
            android:textSize="25sp" />

        <ImageView
            android:id="@+id/bandMark"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="3dp"
            android:clickable="true"
            android:contentDescription="Open the ADD site"
            android:focusable="true"
            android:padding="1dp"
            android:src="@drawable/ic_mark"
            android:tint="?attr/band" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bandDescriptors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="44dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/libre_franklin"
            android:includeFontPadding="false"
            android:text="Art Design Database"
            android:textColor="?attr/onDim"
            android:textSize="9sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/libre_franklin"
            android:includeFontPadding="false"
            android:text="Icons • Fonts • Tools"
            android:textColor="?attr/onDim"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/burger"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="end|center_vertical"
        android:clickable="true"
        android:contentDescription="Open side panel"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="&#9776;"
        android:textColor="?attr/on"
        android:textSize="17sp" />
</FrameLayout>
