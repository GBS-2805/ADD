<?xml version="1.0" encoding="utf-8"?>
<!--
  One edition: newsprint. The source is the final paper block in
  docs/assets/site.css; this file is the Android copy of those tokens.

  A card is the page with 7% of the ink mixed in, and a panel is 12% - the two
  tints site.css paints as rgba(). The band ink is darker than the page ink so
  words on the stamp red keep 4.5:1; the page ink is the brief's #15120E.
-->
<resources>

    <color name="newsprint_band">#dd4124</color>
    <color name="newsprint_band_ink">#0f0b08</color>
    <color name="newsprint_band_dim">#a80f0b08</color>
    <color name="newsprint_band_line">#3d0f0b08</color>
    <color name="newsprint_accent">#dd4124</color>
    <color name="newsprint_accent_ink">#0f0b08</color>
    <color name="newsprint_label">#15120e</color>
    <color name="newsprint_page">#e9e0cb</color>
    <color name="newsprint_on">#15120e</color>
    <color name="newsprint_on_dim">#625b4f</color>
    <color name="newsprint_rule">#3d15120e</color>
    <color name="newsprint_card">#dad2be</color>
    <color name="newsprint_panel2">#d0c7b4</color>
    <color name="newsprint_warn">#8a3b00</color>

    <!-- The launcher's own disc. The icon is a fixed asset, not a themed surface. -->
    <color name="iconBg">#d9d9d9</color>
</resources>
