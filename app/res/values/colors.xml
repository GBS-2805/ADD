<?xml version="1.0" encoding="utf-8"?>
<!--
  The three palettes of the site, one block each, taken from the same values as
  docs/assets/site.css so the app and the pages cannot drift.

  A palette is: the band, the words on that band, its accent (which fills the
  count chips and pills), the small labels, and the page with the words that sit
  on it. The band holds in both modes; only the page turns over, which is why
  each palette has a dark page set and a light one.

  A card is the page with 7% of the words mixed in, and a panel is 12% - the
  two tints site.css paints as rgba().
-->
<resources>

    <!-- Green: the original band, bright with near-black words on it. -->
    <color name="green_band">#0fbf92</color>
    <color name="green_band_ink">#0f120f</color>
