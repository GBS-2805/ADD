<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The one edition. The manifest names this theme; no activity swaps it. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="page">@color/newsprint_page</item>
        <item name="on">@color/newsprint_on</item>
        <item name="onDim">@color/newsprint_on_dim</item>
        <item name="rule">@color/newsprint_rule</item>
        <item name="card">@color/newsprint_card</item>
        <item name="panel2">@color/newsprint_panel2</item>
        <item name="band">@color/newsprint_band</item>
        <item name="bandInk">@color/newsprint_band_ink</item>
        <item name="bandDim">@color/newsprint_band_dim</item>
        <item name="bandLine">@color/newsprint_band_line</item>
        <item name="accent">@color/newsprint_accent</item>
        <item name="accentInk">@color/newsprint_accent_ink</item>
        <item name="label">@color/newsprint_label</item>
        <item name="ink">@color/newsprint_band_ink</item>
        <item name="warn">@color/newsprint_warn</item>
        <item name="warnBg">@color/newsprint_card</item>
        <item name="shadow">#00000000</item>
        <item name="android:windowBackground">@color/newsprint_page</item>
        <item name="android:fontFamily">@font/libre_franklin</item>
        <item name="android:colorAccent">@color/newsprint_accent</item>
        <item name="android:colorPrimary">@color/newsprint_band</item>
        <item name="android:colorPrimaryDark">@color/newsprint_band</item>
        <item name="android:textColorPrimary">@color/newsprint_on</item>
        <item name="android:textColorSecondary">@color/newsprint_on_dim</item>
        <item name="android:statusBarColor">@color/newsprint_band</item>
        <item name="android:navigationBarColor">@color/newsprint_page</item>
        <!-- Paper is a light surface: both system bar icon sets are dark. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- The editor's sheets slide up from the dock and leave the same way. -->
    <style name="SheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_up</item>
        <item name="android:windowExitAnimation">@anim/sheet_down</item>
    </style>
</resources>
