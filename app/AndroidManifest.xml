<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.offline.compress">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <!-- Legacy devices only (API 26-28) need this to publish into Pictures. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- The one network job: fetching a font pack the reader tapped in Font packs.
         Nothing else in the app opens a socket. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:label="ADD"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- The native screen is the way in. The shelf is one tap away in the side
             tab; launching straight into its WebView made the app read as the website.
             The compressor still takes shares from Android's own sheet. -->
        <activity
            android:name="add.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="ADD">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share a photo, or a handful, from any gallery or camera app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- The shelf, bundled whole: reached from the side tab, not the launcher. -->
        <activity
            android:name="add.ShelfActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="ADD"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="add.CompareActivity"
            android:exported="false"
            android:label="Compare"
            android:parentActivityName="add.MainActivity" />

        <!-- The editor: photo, type, presets, adjustments, layers and export. Native,
             and reachable from the drawer and from the Tools page through the bridge. -->
        <activity
            android:name="add.EditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:label="Editor"
            android:windowSoftInputMode="adjustResize" />

        <!-- Font packs: the site's list, its packs, and the offline copy on the phone.
             Network use is explicit here: the reader taps Download. -->
        <activity
            android:name="add.PacksActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:label="Font packs" />
    </application>
</manifest>
